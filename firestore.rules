rules_version = '2';

// Know N1SK — Firestore rules.
// The `admin` collection holds the site content that powers the public
// Home page. Everyone may read it; only signed-in admins may write it.
// The `posts` collection holds the published posts — everyone may read
// them, admins create/update/delete them, and anyone may increment a
// post's view counter (the only unauthenticated write allowed).
service cloud.firestore {
  match /databases/{database}/documents {
    match /admin/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }
  }
}
