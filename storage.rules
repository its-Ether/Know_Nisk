rules_version = '2';

// Know N1SK — Storage rules.
// The editor uploads cover + avatar images under `images/` and post
// attachments under `posts/`. Everyone may read them (the public Home page
// displays them); only signed-in admins may upload.
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /posts/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
